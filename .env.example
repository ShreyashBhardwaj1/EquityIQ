# ------------------------------------------------------------------------------
# EquityIQ Environment Variables Template (.env.example)
# Copy this file to .env.development, .env.testing, or .env.production as needed.
# ------------------------------------------------------------------------------

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# FastAPI Server
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL)
POSTGRES_USER=equityiq
POSTGRES_PASSWORD=equityiq_password
POSTGRES_DB=equityiq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://equityiq:equityiq_password@localhost:5432/equityiq

# Redis Configuration (Celery Broker & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Authentication (JWT)
JWT_SECRET=super_secret_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 (Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AI & LLM Provider Configuration
# Supported providers: openai, gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Store Configuration
# Supported stores: faiss (local)
VECTOR_STORE=faiss
FAISS_INDEX_PATH=backend/app/infrastructure/rag/faiss_index

# Embedding Configuration
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=bge-small-en-v1.5-v1

# Sentiment Model Configuration
FINBERT_MODEL_NAME=yiyanghkust/finbert-tone

# SEC EDGAR Downloader Configuration
SEC_EDGAR_USER_AGENT="YourName YourEmail@domain.com"
