# EquityIQ Testing Environment Configuration
ENVIRONMENT=testing
LOG_LEVEL=WARNING

HOST=127.0.0.1
PORT=8001

# Database Configuration (Uses separate test DB)
POSTGRES_USER=equityiq
POSTGRES_PASSWORD=equityiq_password
POSTGRES_DB=equityiq_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://equityiq:equityiq_password@localhost:5432/equityiq_test

# Redis Configuration (Uses separate DB index 1)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/1

# JWT Authentication
JWT_SECRET=testing_secret_key_used_in_pytest
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=1

# AI Configuration (mock keys for offline tests)
LLM_PROVIDER=openai
OPENAI_API_KEY=mock-testing-key
GEMINI_API_KEY=mock-testing-key

VECTOR_STORE=faiss
FAISS_INDEX_PATH=backend/tests/faiss_index_test
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=bge-small-en-v1.5-test

FINBERT_MODEL_NAME=yiyanghkust/finbert-tone
SEC_EDGAR_USER_AGENT="EquityIQTester test@equityiq.com"
