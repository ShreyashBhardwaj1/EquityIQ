# EquityIQ Production Environment Configuration Template
ENVIRONMENT=production
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

# Database Configuration (Must be set via secrets manager in cloud)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=equityiq_prod
POSTGRES_HOST=
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:5432/equityiq_prod

# Redis Configuration
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:<PASSWORD>@<HOST>:6379/0

# JWT Authentication (Must be strong generated secret keys)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 (Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# AI Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

VECTOR_STORE=faiss
FAISS_INDEX_PATH=/var/lib/equityiq/faiss_index
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=bge-small-en-v1.5-v1

FINBERT_MODEL_NAME=yiyanghkust/finbert-tone
SEC_EDGAR_USER_AGENT=
